{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.verahelm.com/schemas/trust-bundle-1.0.0.json",
  "title": "Verahelm offline trust bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "version", "valid_from", "expires_at", "keys"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "bundle_id": { "type": "string", "pattern": "^tb_[a-z0-9_]{8,80}$" },
    "version": { "type": "integer", "minimum": 1 },
    "valid_from": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuer_id", "key_id", "public_key", "fingerprint", "valid_from", "expires_at"],
        "properties": {
          "issuer_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "key_id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "public_key": { "type": "string", "minLength": 1, "maxLength": 16384 },
          "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "valid_from": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
